# Copy this file to `.env` and fill in the values.
# Read by django-environ (see config/settings/base.py).

# Which settings module to use. Options:
#   config.settings.dev         (default for local development)
#   config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.dev

# SECURITY: generate a real key for anything but throwaway dev.
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# true / false
DEBUG=true

# Comma-separated list of hosts.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Defaults to local sqlite if omitted.
# Postgres example:
# DATABASE_URL=postgres://user:password@localhost:5432/dental
DATABASE_URL=sqlite:///db.sqlite3

# Comma-separated list of allowed frontend origins for CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Production-only (safe to leave as-is in dev) ---
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=604800
